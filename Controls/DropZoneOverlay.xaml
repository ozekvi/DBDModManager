<UserControl x:Class="DbdModManager.Controls.DropZoneOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             IsHitTestVisible="False" Focusable="False"
             d:DesignWidth="500" d:DesignHeight="400">
    <Grid>
        <Border Background="#B3000000" CornerRadius="20"/>

        <Rectangle Stroke="{DynamicResource AccentBrush}" StrokeThickness="2" StrokeDashArray="6 4"
                   RadiusX="16" RadiusY="16" Margin="14"/>

        <Border Background="{DynamicResource SecondaryBrush}" BorderThickness="1"
                BorderBrush="{DynamicResource AccentBrush}" CornerRadius="16"
                Padding="28,20" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Border.Effect>
                <DropShadowEffect Color="Black" BlurRadius="24" ShadowDepth="0" Opacity="0.5"/>
            </Border.Effect>
            <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                <Path Data="{StaticResource Icon.UploadTray}" Stroke="{DynamicResource AccentBrush}"
                      Fill="Transparent" StrokeThickness="1.6" StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round" StrokeLineJoin="Round" Stretch="Uniform"
                      Width="36" Height="36" HorizontalAlignment="Center"/>
                <TextBlock Text="Отпустите, чтобы добавить мод" Foreground="{DynamicResource TextBrush}"
                           FontSize="15" FontWeight="Bold" Margin="0,14,0,4"
                           HorizontalAlignment="Center" TextAlignment="Center"/>
                <TextBlock Text=".pak-папки, .zip, .rar, .mmpackage" Foreground="{DynamicResource MutedTextBrush}"
                           FontSize="11" HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
